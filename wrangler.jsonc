{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sweetdevil",
  "main": ".open-next/worker.js",

  // nodejs_compat + a date >= 2024-09-23 are both hard requirements of
  // @opennextjs/cloudflare. Lowering either breaks the Next.js runtime.
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],

  // ── LIVE ───────────────────────────────────────────────────────────────
  // sweetdevil.in and www both serve this Worker. Cloudflare owns and creates
  // the DNS records for these hostnames; the old Wix A records and www CNAME
  // were deleted first, because a Custom Domain cannot attach over a
  // conflicting record.
  //
  // Both apex and www are listed deliberately: Wix served www and 301'd the
  // apex to it, so links to both forms exist in the wild and both must resolve.
  //
  // ROLLBACK to Wix — remove these routes, then re-add in Cloudflare DNS:
  //   A      sweetdevil.in       185.230.63.186 / .171 / .107   (DNS only)
  //   CNAME  www.sweetdevil.in   cdn1.wixdns.net                (DNS only)
  "routes": [
    { "pattern": "sweetdevil.in", "custom_domain": true },
    { "pattern": "www.sweetdevil.in", "custom_domain": true }
  ],

  // Adding `routes` silently turns this off. Keep it on: the workers.dev URL is
  // the way back into the store if anything is ever wrong with the domain, and
  // it's the address used for testing without touching the live site.
  "workers_dev": true,

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Order records. Created in APAC so writes are close to customers in India.
  // The schema lives in migrations/ — apply with:
  //   npx wrangler d1 migrations apply sweetdevil-orders --remote
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sweetdevil-orders",
      "database_id": "f9f50459-eac3-4f6a-9912-6eb5b0857cec",
      "migrations_dir": "migrations"
    }
  ],

  // Free tier includes logs; leave on so a failing checkout is diagnosable
  // once payments are live.
  "observability": {
    "enabled": true
  }
}
