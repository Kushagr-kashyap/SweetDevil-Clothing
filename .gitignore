# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# wrangler's local-dev secrets file — same rule as .env, per Cloudflare's docs
.dev.vars*

# vercel
.vercel

# project-private (never commit)
/0_Secrets/
/.claude/

# typescript
*.tsbuildinfo
next-env.d.ts

# cloudflare / opennext build output
/.open-next/

# NOTE: cloudflare-env.d.ts is generated (`npm run cf-typegen`) but IS committed.
# It contains only binding type declarations, never secrets, and `tsc` fails
# without it on a fresh clone.

# wrangler local state (caches, local D1 copies)
/.wrangler/
